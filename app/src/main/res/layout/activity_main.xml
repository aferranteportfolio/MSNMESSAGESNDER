<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Envío de SMS"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Los mensajes se enviarán usando la SIM de este teléfono."
            android:textColor="#4B5563"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/recipients_label"
            android:textColor="#111827"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/recipientsInput"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            android:gravity="top|start"
            android:hint="@string/recipients_hint"
            android:inputType="phone|textMultiLine"
            android:padding="14dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/message_label"
            android:textColor="#111827"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            android:gravity="top|start"
            android:hint="@string/message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="@string/send_button"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/status_ready"
            android:textColor="#374151"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
